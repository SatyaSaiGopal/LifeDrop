# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local MongoDB instance. For Atlas use:
# mongodb+srv://<user>:<pass>@<cluster>/lifeline?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lifeline

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed browser origins.
# NOTE: "localhost" and "127.0.0.1" are different origins to a browser — list
# both if you open the app under either hostname.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
# "local" stores profile photos on disk under /uploads and serves them from the API.
UPLOAD_DRIVER=local
MAX_UPLOAD_MB=2

# ---- Search defaults ----
DEFAULT_SEARCH_RADIUS_KM=25
MAX_SEARCH_RADIUS_KM=100
DONOR_MIN_AGE=18
DONOR_MAX_AGE=65
