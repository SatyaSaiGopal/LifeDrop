# Base URL for the API. Leave as "/api" in development to use the Vite proxy
# (single origin, so the httpOnly session cookie works without CORS).
# In production set this to your API origin, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Set to "false" to disable the map entirely. The app degrades gracefully:
# donor results, distances and filters keep working without a map.
VITE_MAP_ENABLED=true

# Only needed for `vite dev` when the backend runs somewhere other than :5000.
VITE_PROXY_TARGET=http://localhost:5000
